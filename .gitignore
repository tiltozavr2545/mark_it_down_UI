# macOS
.DS_Store

# Dart/Flutter — will appear at Stage 0, but let it sit here ahead of time
.dart_tool/
.packages
build/
# An app, not a library — but there's nothing to pin versions against
# before the first release; remove this entry once there's a CI release build
pubspec.lock
*.iml
.flutter-plugins
.flutter-plugins-dependencies

# Signing release builds — keys never go into the repository
android/key.properties
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# Python sidecar: built by a script, not committed to the repository
# (see docs/python-sidecar.md)
sidecar/python/
sidecar/lib/
sidecar/dist/
# build.sh's download cache (interpreter archive) and build stamps
sidecar/cache/

# PDFium: downloaded by the pdfium/fetch.sh script, not committed to the
# repository (see docs/format-coverage.md#pdf-how-to-extract-text)
pdfium/native/
app/android/app/src/main/jniLibs/

# Tesseract (OCR): sources, build and models are downloaded by
# tesseract/fetch.sh and built by tesseract/build.sh, not committed to the
# repository
tesseract/cache/
tesseract/build/
tesseract/native/
tesseract/tessdata/
app/assets/tessdata/*.traineddata

# Speech recognition: sources, build and models are downloaded by
# whisper/fetch.sh and built by whisper/build.sh, not committed to the
# repository
whisper/cache/
whisper/build/
whisper/native/
whisper/models/
app/assets/whisper/*.bin
app/assets/whisper/models.json

# Claude Code: local config and launch profiles, these are per-machine
.claude/settings.local.json
.claude/launch.json
