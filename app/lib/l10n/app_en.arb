  "convertingLabel": "Converting…",
  "@convertingLabel": {"description": "Shown next to the spinner while conversion runs"},

  "copyButton": "Copy",
  "copiedConfirmation": "Copied to clipboard",
  "saveAsButton": "Save as .md",
  "savedConfirmation": "Saved",
  "warningsLabel": "Warnings",

  "errorUnsupportedTitle": "Format not supported",
  "errorUnsupportedBody": "{format} isn't supported yet.",
  "@errorUnsupportedBody": {
    "description": "Shown when no converter accepted the detected format",
