<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Release: песочница ВКЛЮЧЕНА и сети НЕТ. Это не формальность, а то самое
  «OS-enforced offline» из docs/offline-and-privacy.md: без app-sandbox
  отсутствие network.client ничего не запрещает. Сайдкар (Python) запускается
  подпроцессом и наследует эту песочницу, то есть тоже без сети.
  Любой com.apple.security.network.* здесь — ошибка; CI это проверяет
  (шаг «нет network.* в Release.entitlements»). Подробности — docs/operations.md.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
