<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Release: песочница ВКЛЮЧЕНА. С 0.9 есть network.client — исходящие
  соединения для режима «ссылка» (скачать страницу или файл по ссылке,
  docs/offline-and-privacy.md). network.server (входящие) здесь — ошибка;
  CI это проверяет. Сайдкар наследует песочницу и вместе с ней
  network.client: сетевые конвертеры markitdown в нём не установлены, это
  и держит его без сети (см. docs/python-sidecar.md). Подробности —
  docs/operations.md.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
