<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the sidecar's interpreter (sidecar/dist/<host>/python/bin/python3.12).
  The rationale for each line and how to verify it — docs/python-sidecar.md, "Signing".

  What's deliberately NOT here:
  - com.apple.security.network.* — the sidecar is offline (docs/offline-and-privacy.md);
  - allow-unsigned-executable-memory / allow-jit — the markitdown path (pdf, docx,
    xlsx, xls, pptx, msg) works without them; they're only needed for ctypes
    callbacks, which aren't on this path (without them, the process hangs on
    a callback);
  - app-sandbox / inherit — not needed for the DMG: a sandboxed app's
    subprocess inherits the sandbox from its parent (can't verify this yet on
    a live .app). Both would be needed for the Mac App Store — that's a
    separate decision.
-->
<plist version="1.0">
<dict>
	<!-- All .so/.dylib files in lib/ are signed by us, but with ad-hoc signing they
	     have no Team ID, and without this key Hardened Runtime refuses to load them. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
